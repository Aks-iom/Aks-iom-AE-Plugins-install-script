<Window x:Class="AEPluginInstaller.Views.TelemetryConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AEPluginInstaller.Services.Localization"
        Title="Разрешение на телеметрию"
        SizeToContent="Height"
        Width="460"
        MaxHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Border Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="DragWindow" Background="Transparent">
                <TextBlock Text="Улучшение приложения"
                           Foreground="{DynamicResource TextBrush}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Margin="16,10"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel Margin="22,4,22,16">
                    <Image Source="/Assets/logo.ico"
                           Width="48" Height="48"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <TextBlock Text="Помогите сделать установщик лучше"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="17"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Установщик отправляет анонимные отчёты об ошибках и установках плагинов — это помогает быстрее исправлять баги."
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock TextAlignment="Center" Margin="0,0,0,10">
                        <Hyperlink NavigateUri="https://telegra.ph/Telemetriya-AE-Plugins-Installer-05-27"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextDecorations="None">
                            Подробнее о собираемых данных
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock Text="Личные данные, списки файлов и пароли не собираются."
                               Foreground="{DynamicResource SuccessBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Даже при отказе на сервер уходит пустой файл со счётчиком установок и анонимным ID — без содержимого журнала. Изменить выбор и посмотреть свой ID можно в Настройках."
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,14"/>

                    <CheckBox x:Name="CbConsent"
                              Content="Разрешить отправку анонимных отчётов с журналом"
                              IsChecked="True"
                              HorizontalAlignment="Center"
                              FontSize="13"
                              Margin="0,0,0,14"/>

                    <!-- Путь к After Effects -->
                    <TextBlock Text="{loc:T Key=tcd.ae_path.title}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="2,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="AePathBox"
                                     Padding="8,6"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"
                                     TextChanged="AePathBox_TextChanged"/>
                            <TextBlock x:Name="AePathPlaceholder"
                                       Text="{loc:T Key=tcd.ae_path.placeholder}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="12"/>
                        </Grid>
                        <Button Grid.Column="1"
                                Content="{loc:T Key=tcd.ae_path.browse}"
                                Style="{DynamicResource GhostButton}"
                                Padding="12,6"
                                Margin="8,0,0,0"
                                Click="BrowseAePath_Click"/>
                    </Grid>
                    <TextBlock Text="{loc:T Key=tcd.ae_path.hint}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="2,6,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource BgBrush}" CornerRadius="0,0,10,10" Padding="16,12">
                <Button Content="Продолжить"
                        Style="{DynamicResource PrimaryButton}"
                        Click="Continue_Click"
                        HorizontalAlignment="Stretch"/>
            </Border>
        </Grid>
    </Border>
</Window>
