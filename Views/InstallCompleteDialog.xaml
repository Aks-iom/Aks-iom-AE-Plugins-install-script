<Window x:Class="AEPluginInstaller.Views.InstallCompleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AEPluginInstaller.Services.Localization"
        Title="AE Plugin Installer"
        SizeToContent="Height"
        Width="480"
        MinHeight="220"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        Icon="/Assets/logo.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="26,24,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Иконка + заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="IconText" Text="✓" FontSize="26"
                       Foreground="{StaticResource SuccessBrush}"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:T Key=dlg.done.title}"/>
        </StackPanel>

        <!-- Сводка: успешно/с ошибками -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:T Key=dlg.done.ok}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="OkCountText" Text="0"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:T Key=dlg.done.fail}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="FailCountText" Text="0"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Подсказка по ошибкам (видна только когда fail > 0) -->
        <TextBlock Grid.Row="2"
                   x:Name="HintText"
                   Text="{loc:T Key=dlg.done.hint_fail}"
                   FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="Collapsed"/>

        <!-- Связь с автором -->
        <Border Grid.Row="3"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,16">
            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}">
                <Run Text="{loc:T Key=dlg.done.contact}"/>
                <Run Text=" "/>
                <Hyperlink NavigateUri="https://t.me/not_aks"
                           RequestNavigate="Link_RequestNavigate"
                           Foreground="{StaticResource AccentBrush}"
                           TextDecorations="Underline">@not_aks</Hyperlink>
            </TextBlock>
        </Border>

        <!-- Кнопка закрытия -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:T Key=dlg.ok}"
                    Style="{StaticResource PrimaryButton}"
                    Padding="22,8" MinWidth="90"
                    Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
