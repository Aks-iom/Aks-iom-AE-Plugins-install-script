<Window x:Class="AEPluginInstaller.Views.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление"
        SizeToContent="Height"
        Width="460"
        MinHeight="170"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        Icon="/Assets/logo.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="24,22,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="⬆"
                       FontSize="22"
                       Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <TextBlock x:Name="HeaderText"
                       Text="Доступно обновление"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   x:Name="MessageText"
                   FontSize="13"
                   Foreground="{StaticResource TextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <!-- Блок прогресса (виден только после нажатия "Да") -->
        <StackPanel Grid.Row="2"
                    x:Name="ProgressPanel"
                    Visibility="Collapsed"
                    Margin="0,0,0,16">
            <ProgressBar x:Name="DownloadProgress"
                         Height="10"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>
            <TextBlock x:Name="ProgressText"
                       Text=""
                       FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    x:Name="ButtonsPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="NoBtn"
                    Content="Нет"
                    Style="{StaticResource GhostButton}"
                    MinWidth="80"
                    Padding="18,8"
                    Margin="0,0,8,0"
                    Click="No_Click"
                    IsCancel="True"/>
            <Button x:Name="YesBtn"
                    Content="Да"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="80"
                    Padding="18,8"
                    Click="Yes_Click"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
